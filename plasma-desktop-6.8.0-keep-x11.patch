diff -ruN --no-dereference '--exclude=po' '--exclude=build' '--exclude=*.po' '--exclude=.git' '--exclude=CMakeFiles' plasma-desktop-pristine/kcms/touchpad/backends/x11/xlibnotifications.cpp plasma-desktop/kcms/touchpad/backends/x11/xlibnotifications.cpp
